// Prisma schema for Better Auth
// learn more: https://better-auth.com/docs/concepts/database

generator client {
  provider = "prisma-client-js"
  output   = "../generated/prisma"
}

// NOTE: When using mysql or sqlserver, uncomment the //@db.Text annotations in model Account below
// Further reading:
// https://www.prisma.io/docs/reference/api-reference/prisma-schema-reference#string

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DATABASE_URL_UNPOOLED")
}

model Post {
  id        String   @id @default(cuid())
  name      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  createdBy   User   @relation(fields: [createdById], references: [id])
  createdById String

  @@index([name])
}

model User {
  id            String    @id
  name          String //@db.Text
  email         String
  emailVerified Boolean   @default(false)
  image         String? //@db.Text
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @default(now()) @updatedAt
  sessions      Session[]
  accounts      Account[]
  posts         Post[]
  datasets      Dataset[]

  @@unique([email])
  @@map("user")
}

model Session {
  id        String   @id
  expiresAt DateTime
  token     String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  ipAddress String? //@db.Text
  userAgent String? //@db.Text
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([token])
  @@map("session")
}

model Account {
  id                    String    @id
  accountId             String //@db.Text
  providerId            String //@db.Text
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String? //@db.Text
  refreshToken          String? //@db.Text
  idToken               String? //@db.Text
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String? //@db.Text
  password              String? //@db.Text
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@map("account")
}

model Verification {
  id         String   @id
  identifier String //@db.Text
  value      String //@db.Text
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @default(now()) @updatedAt

  @@map("verification")
}

enum DatasetStatus {
  PROCESSING
  READY
  FAILED
}

model Dataset {
  id           String        @id @default(cuid())
  userId       String?
  user         User?         @relation(fields: [userId], references: [id], onDelete: SetNull)
  name         String
  rawData      Json?
  status       DatasetStatus @default(PROCESSING)
  errorMessage String?       @db.Text
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  brands       Brand[]
  agentRuns    AgentRun[]

  @@index([userId])
  @@map("dataset")
}

enum MessageRole {
  CUSTOMER
  BRAND
}

model Brand {
  id            String         @id @default(cuid())
  datasetId     String?
  dataset       Dataset?       @relation(fields: [datasetId], references: [id], onDelete: Cascade)
  name          String
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  customers     Customer[]
  conversations Conversation[]
  intents       Intent[]

  @@index([datasetId])
  @@map("brand")
}

model Customer {
  id            String         @id @default(cuid())
  brandId       String
  brand         Brand          @relation(fields: [brandId], references: [id], onDelete: Cascade)
  twitterId     String?
  username      String?
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  conversations Conversation[]

  @@index([brandId])
  @@index([twitterId])
  @@map("customer")
}

model Conversation {
  id         String     @id @default(cuid())
  brandId    String
  brand      Brand      @relation(fields: [brandId], references: [id], onDelete: Cascade)
  customerId String?
  customer   Customer?  @relation(fields: [customerId], references: [id], onDelete: Cascade)
  twitterId  String?    @unique
  createdAt  DateTime   @default(now())
  updatedAt  DateTime   @updatedAt
  messages   Message[]
  agentRuns  AgentRun[]

  @@index([brandId])
  @@index([customerId])
  @@map("conversation")
}

model Message {
  id             String       @id @default(cuid())
  conversationId String
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  twitterId      String?      @unique
  authorId       String?
  username       String?
  text           String       @db.Text
  role           MessageRole
  createdAt      DateTime     @default(now())
  evidence       Evidence[]

  @@index([conversationId])
  @@index([authorId])
  @@map("message")
}

model Intent {
  id                 String              @id @default(cuid())
  brandId            String
  brand              Brand               @relation(fields: [brandId], references: [id], onDelete: Cascade)
  name               String
  description        String?             @db.Text
  createdAt          DateTime            @default(now())
  agentRuns          AgentRun[]
  evaluationExamples EvaluationExample[]

  @@unique([brandId, name])
  @@index([brandId])
  @@map("intent")
}

model EvaluationSet {
  id                 String              @id @default(cuid())
  name               String
  version            String
  description        String?             @db.Text
  createdAt          DateTime            @default(now())
  evaluationExamples EvaluationExample[]

  @@map("evaluation_set")
}

model EvaluationExample {
  id                 String        @id @default(cuid())
  evaluationSetId    String
  evaluationSet      EvaluationSet @relation(fields: [evaluationSetId], references: [id], onDelete: Cascade)
  intentId           String?
  intent             Intent?       @relation(fields: [intentId], references: [id], onDelete: SetNull)
  text               String        @db.Text
  expectedEscalation Boolean       @default(false)
  expectedReply      String?       @db.Text
  notes              String?       @db.Text
  createdAt          DateTime      @default(now())
  agentRuns          AgentRun[]

  @@index([evaluationSetId])
  @@index([intentId])
  @@map("evaluation_example")
}

model AgentRun {
  id                  String             @id @default(cuid())
  datasetId           String?
  dataset             Dataset?           @relation(fields: [datasetId], references: [id], onDelete: Cascade)
  conversationId      String?
  conversation        Conversation?      @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  evaluationExampleId String?
  evaluationExample   EvaluationExample? @relation(fields: [evaluationExampleId], references: [id], onDelete: SetNull)
  predictedIntentId   String?
  predictedIntent     Intent?            @relation(fields: [predictedIntentId], references: [id], onDelete: SetNull)
  inputText           String             @db.Text
  draftReply          String?            @db.Text
  shouldEscalate      Boolean            @default(false)
  escalationReason    String?            @db.Text
  model               String?
  latencyMs           Int?
  createdAt           DateTime           @default(now())
  evidence            Evidence[]

  @@index([datasetId])
  @@index([conversationId])
  @@index([evaluationExampleId])
  @@index([predictedIntentId])
  @@map("agent_run")
}

model Evidence {
  id             String   @id @default(cuid())
  agentRunId     String
  agentRun       AgentRun @relation(fields: [agentRunId], references: [id], onDelete: Cascade)
  messageId      String
  message        Message  @relation(fields: [messageId], references: [id], onDelete: Cascade)
  relevanceScore Float?
  reason         String?  @db.Text

  @@index([agentRunId])
  @@index([messageId])
  @@map("evidence")
}



